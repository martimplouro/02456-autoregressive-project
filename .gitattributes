# Normalise line endings on commit: the repository stores LF for every text file,
# whatever core.autocrlf is set to on the machine that committed. Without this, the
# endings a file gets depend on who touched it last.
* text=auto

# shell scripts must keep LF endings, they run on the Linux cluster
*.sh text eol=lf

# data files are hashed byte-for-byte (manifest input_sha256), so they must
# keep LF endings regardless of core.autocrlf on the checkout machine
data/** text eol=lf
